# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# JWT (сгенерируй длинные случайные строки)
JWT_SECRET=change_me_access_secret_min_32_chars
REFRESH_SECRET=change_me_refresh_secret_min_32_chars

# Админ (этот email при регистрации получает is_admin)
ADMIN_EMAIL=gghaghja@example.com

# SMTP (опционально)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# FCM (опционально)
FCM_SERVER_KEY=

# Server
PORT=3000
NODE_ENV=production
CORS_ORIGINS=*
